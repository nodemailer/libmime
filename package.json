{
    "name": "libmime",
    "description": "Encode and decode quoted printable and base64 strings",
    "version": "5.5.2",
    "type": "module",
    "main": "./dist/cjs/libmime.js",
    "types": "./dist/cjs/libmime.d.ts",
    "typesVersions": {
        "*": {
            "lib/*": [
                "dist/cjs/*.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "import": "./dist/esm/libmime.js",
            "require": "./dist/cjs/libmime.js"
        },
        "./lib/*.js": {
            "import": "./dist/esm/*.js",
            "require": "./dist/cjs/*.js"
        },
        "./lib/*": {
            "import": "./dist/esm/*.js",
            "require": "./dist/cjs/*.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "SECURITY.md"
    ],
    "homepage": "https://github.com/nodemailer/libmime",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nodemailer/libmime.git"
    },
    "license": "MIT",
    "keywords": [
        "MIME",
        "Base64",
        "Quoted-Printable"
    ],
    "author": "Andris Reinman <andris@kreata.ee>",
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "tsc -p tsconfig.json",
        "pretest": "npm run build",
        "test": "node --import tsx --test --test-concurrency=1 $(find test -name \"*-test.ts\")",
        "pretest:coverage": "npm run build",
        "test:coverage": "c8 node --import tsx --test --test-concurrency=1 $(find test -name \"*-test.ts\")",
        "pretest:cjs": "npm run build",
        "test:cjs": "NODE_OPTIONS=--no-experimental-require-module node test/cjs-smoke.cjs",
        "format": "prettier --write \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "npm run build",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install",
        "pretest:bun": "npm run build",
        "test:bun": "bun test --timeout 60000 $(find ./test -name \"*-test.ts\")",
        "test:mutation": "node scripts/mutation-test.js"
    },
    "dependencies": {
        "encoding-japanese": "2.4.0",
        "iconv-lite": "0.7.3",
        "libbase64": "1.4.1",
        "libqp": "3.0.1"
    },
    "devDependencies": {
        "@types/node": "20.19.43",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "nodemailer": "10.1.6",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
